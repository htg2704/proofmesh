# Export in your shell, or load a repository .env with python scripts/dev.py.
PROOFMESH_ENABLE_LIVE=false
PROOFMESH_STORE=sqlite
PROOFMESH_DB=data/proofmesh.sqlite3
# Vertex AI live mode requires all four settings below.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_QUOTA_PROJECT=
# Optional project-local ADC file. Omit to use your own default credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local/credentials.json
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=
PROOFMESH_API_TOKEN=
# On Cloud Run set PROOFMESH_STORE=firestore; SQLite is for local use only.
PROOFMESH_FIRESTORE_COLLECTION=proofmesh_investigations

# Hosted job controls
PROOFMESH_DAILY_JOBS=4
PROOFMESH_LIVE_UNTIL=2026-11-17T18:29:59+00:00
PROOFMESH_TOTAL_JOBS=12

# Third-party and ordinary browser access (explicitly enable on a hosted service).
PROOFMESH_SELF_REGISTRATION=false
PROOFMESH_CLIENT_REQUESTS_PER_MINUTE=120
PROOFMESH_CLIENT_DAILY_JOBS=10
PROOFMESH_REGISTRATIONS_PER_HOUR=30
# Optional JSON map of trusted tester labels to distinct >=32-character secrets.
# Inject through Secret Manager on Cloud Run. Never commit real credentials.
PROOFMESH_TRUSTED_TOKENS={}
